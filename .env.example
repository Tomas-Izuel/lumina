# =============================================================================
# lumina — environment variables
# Copy this file to .env and fill in the values for local development.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (project: lumina)
# Org: yysgimjexxlzgsqczwyk | Region: us-west-2
# Create the project at https://supabase.com/dashboard, then get these values
# from: Project Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>        # Never expose on client side
SUPABASE_ANON_KEY=<anon_key>                   # Safe for public clients (not used by Lambdas)

# -----------------------------------------------------------------------------
# AWS (all resources in us-west-2)
# The Lambda execution role (lumina-lambda-role) provides these permissions
# at runtime. For local dev, use a named profile or set the vars below.
# -----------------------------------------------------------------------------
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=<local-dev-only>
AWS_SECRET_ACCESS_KEY=<local-dev-only>

# S3 Buckets (both must be in us-west-2 — required by Luma Ray 2 in Bedrock)
S3_UPLOAD_BUCKET=lumina-inputs            # Tenant-uploaded images (lifecycle: 2 days)
S3_OUTPUT_BUCKET=lumina-outputs           # Final video output.mp4 (lifecycle: 30 days)

# SQS Queue URLs (FIFO for jobs, Standard for webhooks)
TOUR_JOBS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/<account-id>/lumina-jobs.fifo
WEBHOOK_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/<account-id>/lumina-webhooks

# -----------------------------------------------------------------------------
# Bedrock — Luma Ray 2 (luma.ray-v2:0)
# Region: us-west-2 (same as all other infra — no cross-region)
# Requires model access enabled in AWS Console: Bedrock → Model access → luma.ray-v2:0
# -----------------------------------------------------------------------------
BEDROCK_REGION=us-west-2
BEDROCK_MODEL_ID=luma.ray-v2:0
BEDROCK_PRICE_PER_SECOND=1.50                  # 720p estimate; confirm with: aws pricing get-products --service-code AmazonBedrock

# Video generation parameters
CLIP_DURATION_SECS=9                            # 5 or 9 (Luma Ray 2 supported values)
VIDEO_RESOLUTION=720p                           # 720p or 540p
VIDEO_MODEL_BACKEND=luma_ray2                   # Extension point: kling | veo in v2

# Tour lifecycle
TOUR_GENERATION_TIMEOUT_MINUTES=25              # Poller marks tour failed after this duration

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_API_KEY=<strong-random-secret>            # Protects /admin/* endpoints

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development                         # development | production
LOG_LEVEL=INFO                                  # DEBUG | INFO | WARNING | ERROR
